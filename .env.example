ENVIRONMENT=LOCAL
DEBUG=true

# Mock mode (FR-11): swaps every real courier adapter for a deterministic mock at
# registry level, so the whole service runs with zero courier credentials.
MOCK_MODE=true

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]
CORS_HEADERS=["*"]

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/fraudcheck

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6381

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Credential vault (FR-2) ───────────────────────────────────────────────────
# AES-256-GCM key: exactly 32 bytes, urlsafe-base64 encoded.
# Generate: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=change-me-generate-a-real-32-byte-key
ENCRYPTION_KEY_VERSION=1

# ── Auth policy ───────────────────────────────────────────────────────────────
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
OTP_EXPIRE_MINUTES=15
OTP_RETRY_LIMIT=3
OTP_RETRY_DELAY_MINUTES=2
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10

# ── Courier portals (leave blank in mock mode) ────────────────────────────────
PATHAO_MERCHANT_URL=https://merchant.pathao.com
REDX_BASE_URL=https://redx.com.bd
STEADFAST_BASE_URL=https://portal.packzy.com
